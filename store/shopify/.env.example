# Copy to .env and fill in. NEVER commit .env - it is gitignored.

# Your store domain. "my-store", "my-store.myshopify.com" both work.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from your custom app. Starts with shpat_
# Settings > Apps and sales channels > Develop apps > Create an app
# Required scopes: write_products, read_products, write_publications,
#                  read_publications, write_content, read_content,
#                  write_inventory, read_inventory, read_locations
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - defaults to 2025-01
# SHOPIFY_API_VERSION=2025-01
